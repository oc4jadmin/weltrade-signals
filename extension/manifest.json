{
  "manifest_version": 3,
  "name": "Weltrade Price Extractor",
  "version": "1.0.0",
  "description": "Extract real-time FX Vol prices from Weltrade Web Terminal",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://secure.weltrade.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://secure.weltrade.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Weltrade Price Extractor",
    "default_popup": "popup.html"
  }
}

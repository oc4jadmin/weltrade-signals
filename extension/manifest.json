{
  "manifest_version": 3,
  "name": "Weltrade Price Extractor",
  "version": "1.4.0",
  "description": "Extract real-time FX Vol prices from Weltrade Web Terminal",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.weltrade.com/*",
    "https://weltrade.com/*",
    "http://localhost:3000/*",
    "http://localhost/*",
    "https://weltrade-signals.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.weltrade.com/*", "https://weltrade.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Weltrade Price Extractor",
    "default_popup": "popup.html"
  }
}

{
  "manifest_version": 3,
  "name": "Weltrade Price Extractor",
  "version": "2.4.0",
  "description": "Extract FX Vol prices from Weltrade Web Terminal",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["*://secure.weltrade.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://secure.weltrade.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Weltrade Price Extractor",
    "default_popup": "popup.html"
  }
}